<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_P13" targetNamespace="http://northwind-private-bank.example.com/bpmn" exporter="northwind-reference-app" exporterVersion="1.0">
  <bpmn:process id="regulatory-reporting-batch" name="Regulatory Reporting Batch" isExecutable="true">
    <bpmn:startEvent id="start" name="Nightly batch trigger">
      <bpmn:outgoing>f1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="start_def">
        <bpmn:timeCycle>30 17 3 * * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="sc_extract_period" />
    <bpmn:scriptTask id="sc_extract_period" name="Compute reporting period">
      <bpmn:extensionElements>
        <zeebe:script expression="=date(now()) - duration(&#34;P1D&#34;)" resultVariable="reportingPeriod" />
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="f2" sourceRef="sc_extract_period" targetRef="sc_build_dataset" />
    <bpmn:scriptTask id="sc_build_dataset" name="Build regulatory dataset">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="build-regulatory-dataset" retries="2" />
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="f3" sourceRef="sc_build_dataset" targetRef="br_classify_transactions" />
    <bpmn:businessRuleTask id="br_classify_transactions" name="Classify transactions">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="classify-transactions-dmn" />
      </bpmn:extensionElements>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="f4" sourceRef="br_classify_transactions" targetRef="mi_submit_per_currency" />
    <bpmn:callActivity id="mi_submit_per_currency" name="Submit per currency pair">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="fx-settlement" bindingType="latest" propagateAllParentVariables="true" propagateAllChildVariables="true" />
        <zeebe:ioMapping>
          <zeebe:input source="=currencyPair" target="currencyPair" />
          <zeebe:input source="=reportingPeriod" target="reportingPeriod" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=currencyPairs" inputElement="currencyPair" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="f5" sourceRef="mi_submit_per_currency" targetRef="end" />
    <bpmn:endEvent id="end" name="Batch complete">
      <bpmn:incoming>f5</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_regulatory-reporting-batch">
    <bpmndi:BPMNPlane id="BPMNPlane_regulatory-reporting-batch" bpmnElement="regulatory-reporting-batch">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sc_extract_period_di" bpmnElement="sc_extract_period">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sc_build_dataset_di" bpmnElement="sc_build_dataset">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="br_classify_transactions_di" bpmnElement="br_classify_transactions">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mi_submit_per_currency_di" bpmnElement="mi_submit_per_currency">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="807" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="807" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
