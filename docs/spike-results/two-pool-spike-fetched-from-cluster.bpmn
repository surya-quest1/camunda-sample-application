<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_TwoPoolSpike" targetNamespace="http://northwind-private-bank.example.com/bpmn" exporter="northwind-reference-app" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_TwoPoolSpike">
    <bpmn:participant id="Participant_0" name="Northwind Processing" processRef="two-pool-spike-executable" />
    <bpmn:participant id="Participant_1" name="Business Analyst Sketch" processRef="two-pool-spike-analyst-pool" />
  </bpmn:collaboration>
  <bpmn:process id="two-pool-spike-executable" name="Two-Pool Spike (Executable)" isExecutable="true">
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="svc" />
    <bpmn:serviceTask id="svc" name="Do work">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="spike-do-work" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f2" sourceRef="svc" targetRef="end" />
    <bpmn:endEvent id="end" name="End" />
  </bpmn:process>
  <bpmn:process id="two-pool-spike-analyst-pool" name="Analyst Pool (non-executable)" isExecutable="false">
    <bpmn:startEvent id="na_start" name="Start" />
    <bpmn:sequenceFlow id="naf1" sourceRef="na_start" targetRef="na_gw" />
    <bpmn:complexGateway id="na_gw" name="Complex routing" />
    <bpmn:serviceTask id="na_svc" name="Branch">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="branch-na" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="naf2" sourceRef="na_gw" targetRef="na_svc" />
    <bpmn:sequenceFlow id="naf3" sourceRef="na_svc" targetRef="na_catch" />
    <bpmn:intermediateCatchEvent id="na_catch" name="Balance threshold reached">
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">=accountBalance &gt; 10000</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="naf4" sourceRef="na_catch" targetRef="na_end" />
    <bpmn:endEvent id="na_end" name="End" />
  </bpmn:process>
</bpmn:definitions>
